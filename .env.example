# arXiv contact in crawler User-Agent
ARXIV_CONTACT_EMAIL=

# Bounded crawl trial defaults
CRAWL_RANGE=thien
CRAWL_OFFSET=0
CRAWL_LIMIT=100

# Parser queue backpressure
QUEUE_SEED=10
QUEUE_HIGH_WATERMARK=100
QUEUE_MAX_PREFETCH=200

# Crawler cluster
CRAWLER_WORKERS=3
ARXIV_MIN_GAP_S=3.0
LEASE_TTL_S=60
JOB_VISIBILITY_TIMEOUT_S=300
MAX_ATTEMPTS=3

# Tiered discovery (producer)
DISCOVERY_TIERS=5,10,20,50,100
DISCOVERY_BACKLOG_STEPS=10,30,60,100
DISCOVERY_COOLDOWN_ROUNDS=3
